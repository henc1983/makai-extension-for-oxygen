<form class="return-form form" name="return-form" method="post">
  <div class="row">
    <div class="input-group">
      <input type="text" id="last-name" name="last_name" placeholder=" " required />
      <label for="last-name"> {{ esc_html__("Last name" , "makai" ) }} <span class="required">*</span></label>
    </div>
    <div class="input-group">
      <input type="text" id="first-name" name="first_name" placeholder=" " required />
      <label for="first-name">{{ esc_html__("First name" , "makai" ) }} <span class="required">*</span></label>
    </div>
  </div>

  <div class="input-group-wrapper">
    <div class="input-group">
      <input type="text" id="order-number" name="order_number" placeholder=" " required />
      <label for="order-number">{{ esc_html__("Ordernumber" , "makai" ) }} <span class="required">*</span></label>
    </div>
    <p class="input-hint">{{ esc_html__("Order ID. The order identification number found in the order confirmation email." , "makai" ) }}</p>
    <p class="input-hint"><strong>{{ esc_html__("Important!" , "makai" ) }}</strong> {{ esc_html__("We can only identify the intention to cancel if the order number received in the email is provided." , "makai") }}</p>
  
  </div>

  <div class="input-group-wrapper">
    <div class="input-group">
      <input type="email" id="email" name="email" placeholder=" " required />
      <label for="email">{{ esc_html__("Email address" , "makai" ) }} <span class="required">*</span></label>
    </div>
    <p class="input-hint"><strong>{{ esc_html__("Important!" , "makai" ) }}</strong> {{ esc_html__("We can only identify the intention to cancel if the e-mail address used during the order is entered." , "makai") }}</p>
  </div>

  <div class="radio-section">
    <p class="radio-title">{{ esc_html__("What does the withdrawal apply to?" , "makai") }}<span class="required">*</span></p>
    <div class="radio-options">
      <label class="radio-btn checked">
        <input type="radio" name="return_scope" value="full" checked />
        <i class="far fa-circle-check"></i>
        <span>{{ esc_html__("Full order" , "makai") }}</span>
      </label>
      <label class="radio-btn ">
        <input type="radio" name="return_scope" value="partial" data-trigger="products" />
        <i class="far fa-circle-xmark"></i>
        <span>{{ esc_html__("Only certain products", "makai") }}</span>
      </label>
     <input type="hidden" name="scope" value="full">
    </div>
  </div>

  <div class="input-group-wrapper hidden products-wrapper">
    <div class="input-group">
      <input type="text" id="products" name="products" placeholder=" " />
      <label for="products">{{ esc_html__("Which product is being withdrawn from?", "makai") }} <span class="required">*</span></label>
    </div>
    <p class="input-hint">{{ esc_html__("In case of multiple products, the product names are separated by commas.", "makai") }}</p>
  </div>

  <div class="checkbox-group">
    <input type="checkbox" id="terms" required />
    <label for="terms">

  
  {{ esc_html__("I would like to cancel the above order and I have read and understood the privary policy informations.", "makai") }}
      <span class="required">*</span>
    </label>
  </div>

  <button type="submit" class="submit-btn"><div class="loader-animation"></div>{{esc_html__("Confirm withdrawal" , "makai")}}</button>
</form>