<form class="return-form" method="post">
  <!-- Vezetéknév és Keresztnév egy sorban -->
  <div class="row">
    <div class="input-group">
      <input type="text" id="last-name" placeholder=" " required />
      <label for="last-name">Vezetéknév <span class="required">*</span></label>
    </div>
    <div class="input-group">
      <input type="text" id="first-name" placeholder=" " required />
      <label for="first-name">Keresztnév <span class="required">*</span></label>
    </div>
  </div>

  <!-- Rendelésszám -->
  <div class="input-group-wrapper">
    <div class="input-group">
      <input type="text" id="order-number" placeholder=" " required />
      <label for="order-number">Rendelésszám <span class="required">*</span></label>
    </div>
    <p class="input-hint">A rendelés azonosítója. A rendelés visszaigazoló e-mailben található, rendelést azonosító szám.</p>
    <p class="input-hint"><strong>Fontos!</strong> Csak akkor tudjuk azonosítani az elállási szándékot, ha az e-mailben kapott rendelés száma kerül megadásra.</p>
  
  </div>

  <!-- E-mail cím -->
  <div class="input-group-wrapper">
    <div class="input-group">
      <input type="email" id="email" placeholder=" " required />
      <label for="email">E-mail cím <span class="required">*</span></label>
    </div>
    <p class="input-hint"><strong>Fontos!</strong> Csak akkor tudjuk azonosítani az elállási szándékot, ha a rendelés során használt e-mail cím kerül megadásra.</p>
  </div>

  <!-- Rádiógombok (Kiválasztás) -->
  <div class="radio-section">
    <p class="radio-title">Mire vonatkozik az elállás? <span class="required">*</span></p>
    <div class="radio-options">
      <label class="radio-btn checked">
        <input type="radio" name="return-scope" value="full" checked />
        <i class="far fa-circle-check"></i>
        <span>Teljes rendelés</span>
      </label>
      <label class="radio-btn ">
        <input type="radio" name="return-scope" value="partial" id="trigger-products" />
        <i class="far fa-circle-xmark"></i>
        <span>Csak bizonyos termékek</span>
      </label>
    </div>
  </div>

  <!-- Dinamikus termékmező -->
  <div class="input-group-wrapper hidden" id="products-wrapper">
    <div class="input-group">
      <input type="text" id="products" placeholder=" " />
      <label for="products">Melyik terméktől történik az elállás? <span class="required">*</span></label>
    </div>
    <p class="input-hint">Több termék esetén a terméknevek vesszővel elválasztva.</p>
  </div>

  <!-- Adatkezelési checkbox -->
  <div class="checkbox-group">
    <input type="checkbox" id="terms" required />
    <label for="terms">
      El kívánok állni a fenti rendeléstől és kijelentem, hogy az adatkezelési tájékoztatót elolvastam és megértettem. <span class="required">*</span>
    </label>
  </div>

  <!-- Küldés gomb -->
  <button type="submit" class="submit-btn">Elállás megerősítése</button>
</form>