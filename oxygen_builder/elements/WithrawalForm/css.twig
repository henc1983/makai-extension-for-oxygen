%%SELECTOR%% .submit-btn {
background-color: {{ design.submit_button.background }};
color: {{ design.submit_button.text }};
}

%%SELECTOR%% .submit-btn:hover {
background-color: {{ design.submit_button.background_hover }};
color: {{ design.submit_button.text_hover }};
}

%%SELECTOR%% .radio-btn.checked {
background-color: {{ design.radio_buttons.background }};
color: {{ design.radio_buttons.text }};
}