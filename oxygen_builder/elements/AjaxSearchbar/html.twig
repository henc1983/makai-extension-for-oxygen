<form class="search-form form" method="post" role="search" title="{{ esc_html__('Search...', 'makai') }}">
    
    <div class="row">
        <div class="input-group">
            <input class="input-field" name="s" placeholder=" " value="{{ search_query|default('') }}" autocomplete="off">
            <label> {{ esc_html__('Search', 'makai') }} </label>
        </div>

        <button class="submit-btn" type="submit">
            <div class="loader-animation"></div>
            <i class="icon far fa-search"></i>
        </button>
    </div>
  
    
    <input type="hidden" value="product" name="post_type">

  
</form>
  
<div class="result-container modal-filters"></div>